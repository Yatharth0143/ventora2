# ============================================
# VENTORA ENVIRONMENT CONFIGURATION (TEMPLATE)
# ============================================

# --- Bhashini (NLTM) ---
BHASHINI_UDYAT_KEY=your_bhashini_udyat_key_here
BHASHINI_INFERENCE_KEY=your_bhashini_inference_key_here
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services/inference

# --- Sarvam AI ---
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- MongoDB ---
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB_NAME=ventora

# --- Neo4j ---
NEO4J_URI=neo4j+s://instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# --- App ---
SECRET_KEY=generate-a-strong-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_ENV=development
APP_PORT=8000

