# ==============================================================================
# VENTORA PRODUCTION & STAGING ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and supply verified credentials for your environment.
# Note: For frontend builds, variables prefixed with VITE_ are bundled into client code.

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
APP_ENV=production
APP_PORT=8000
# Production secret for signing JWT tokens (Generate with: openssl rand -hex 32)
SECRET_KEY=change-this-in-production-to-a-secure-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Comma-separated allowed CORS origins for FastAPI (Must include production frontend domains)
# Example: https://ventora.in,https://app.ventora.in,https://ventora.vercel.app
CORS_ORIGINS=https://ventora.in,https://app.ventora.in,http://localhost:5173

# Comma-separated admin email addresses authorized to verify investors
ADMIN_EMAILS=admin@ventora.in,team@ventora.in

# ------------------------------------------------------------------------------
# 2. PRIMARY DATABASE: MONGODB ATLAS
# ------------------------------------------------------------------------------
# Production connection string with replica set and TLS enabled
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority&appName=VentoraCluster
MONGODB_DB_NAME=ventora

# ------------------------------------------------------------------------------
# 3. KNOWLEDGE & CONFLICT GRAPH: NEO4J AURADB
# ------------------------------------------------------------------------------
# Use neo4j+s:// or neo4j+ssc:// protocol for encrypted cloud AuraDB instances
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_auradb_password
NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# 4. INDIC LANGUAGE PIPELINE: BHASHINI (NLTM)
# ------------------------------------------------------------------------------
# Keys from the Indian Government NLTM Bhashini portal (https://bhashini.gov.in)
BHASHINI_UDYAT_KEY=your_bhashini_udyat_key_here
BHASHINI_INFERENCE_KEY=your_bhashini_inference_key_here
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services/inference

# ------------------------------------------------------------------------------
# 5. FOUNDATIONAL AI: SARVAM AI
# ------------------------------------------------------------------------------
# Subscription key from Sarvam AI developer portal (https://sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE: CLOUDINARY
# ------------------------------------------------------------------------------
# Cloudinary account credentials for securely storing uploaded deck PDFs
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 7. AUTHENTICATION & SINGLE SIGN-ON (GOOGLE OAUTH)
# ------------------------------------------------------------------------------
# Backend validation audience
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 8. FRONTEND BUNDLE VARIABLES (Vite / React)
# ------------------------------------------------------------------------------
# Vite requires VITE_ prefix to expose variables to client-side window code.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Base URL for backend API in production (Leave empty or set to '/api' if behind reverse proxy)
VITE_API_BASE_URL=https://api.ventora.in
